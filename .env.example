# ---------------------------------------------------------------------------
# Copy to .env and adjust. Every value below has a working default, so the app
# runs with no .env at all -- this file documents what can be tuned.
# ---------------------------------------------------------------------------

# Core Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Database --------------------------------------------------------------------
# Leave DATABASE_URL unset to use SQLite (zero setup, recommended for review).
# DATABASE_URL=postgres://user:password@localhost:5432/fuelroute

# Cache -----------------------------------------------------------------------
# Leave REDIS_URL unset to use in-process LocMemCache.
# REDIS_URL=redis://localhost:6379/0

# Vehicle (assignment constants) ----------------------------------------------
VEHICLE_MAX_RANGE_MILES=500
VEHICLE_MPG=10

# Route/station tuning --------------------------------------------------------
# How far off the route a station may sit and still be considered reachable.
FUEL_STATION_CORRIDOR_MILES=10
# Polyline resampling resolution for the corridor search (finer = slower).
ROUTE_RESAMPLE_MILES=1.0
# Gallons held back as a safety margin (0 = use the full tank).
FUEL_RESERVE_GALLONS=0

# External providers ----------------------------------------------------------
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=15
OSRM_MAX_RETRIES=2
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_TIMEOUT_SECONDS=10
# Nominatim's usage policy requires a real identifying User-Agent.
GEOCODER_USER_AGENT=fuel-route-optimizer/1.0 (contact: you@your-real-domain.com)
CENSUS_GAZETTEER_YEAR=2024

# Cache lifetimes (seconds) ---------------------------------------------------
GEOCODE_CACHE_TTL_SECONDS=2592000
ROUTE_CACHE_TTL_SECONDS=86400
PLAN_CACHE_TTL_SECONDS=21600

# API -------------------------------------------------------------------------
API_THROTTLE_ANON=60/min
